
@addTagHelper *,Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
</head>
<body>

    <nav class="mt-5">

        <center>

            @* <a href="/Home/Index" class="btn btn-primary">Home</a>*@  

            <a asp-controller="Home" asp-action="Index" class="btn btn-primary" >Home</a>
            <a href="/Home/AboutUs" class="btn btn-warning">About Us</a>
            <a href="/Home/Privacy" class="btn btn-success">Privacy</a>
            <a href="/Home/ContactUs" class="btn btn-light">Contact Us</a>
            <a href="/Account/Login" class="btn btn-danger">Login</a>
            <a href="/Account/Register" class="btn btn-dark">Register </a>
            


        </center>




    </nav>

    <div>
        @RenderBody()
    </div>

    @*Start Footer*@

    <footer dlass="mt-5">
        <center>
            <div>
                <p>CopyRights &copy; @DateTime.Now.Year</p>
            </div>
        </center>
    </footer>



    @*End Footer*@

</body>
</html>
